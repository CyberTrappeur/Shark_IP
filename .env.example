# Copy this file to .env and fill in the keys you have.
# Every key is OPTIONAL: a module with no key is skipped, not fatal.
# .env is git-ignored — never commit real keys.

# AbuseIPDB — https://www.abuseipdb.com/account/api  (free tier available)
ABUSEIPDB_API_KEY=

# VirusTotal v3 — https://www.virustotal.com/gui/my-apikey  (free tier available)
VT_API_KEY=

# Censys Platform API — https://platform.censys.io  (free tier available)
# Create a Personal Access Token (user icon -> API Access). It starts "censys_".
CENSYS_API_TOKEN=
# Organization ID: optional, only for Starter/Search/Core (paid) orgs. Leave
# blank on the free tier.
CENSYS_ORG_ID=

# vpnapi.io — https://vpnapi.io/dashboard  (free tier available)
VPNAPI_KEY=

# iknowwhatyoudownload (IKWYD) — P2P/torrent activity history
# OPTIONAL and OFF BY DEFAULT: the module runs only if this key is present.
# Sensitive module — read the "Legal & responsible use" section of the README
# before enabling it. https://iknowwhatyoudownload.com/en/api/
IKWYD_API_KEY=
